<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvGreeting"
        style="@style/TextViewDefault"
        android:layout_marginTop="40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="54dp"
        android:text="hello, {username}! you have {count} tasks at today"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout_menu"
        android:layout_marginTop="80dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/AutumnHarvest_paleBrown"


        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGreeting">

        <Button
            android:id="@+id/btnGoToTasks"
            style="@style/ButtonDefault"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="40dp"
            android:layout_marginVertical="20dp"
            android:layout_height="wrap_content"
            android:text="@string/goToTasks" />
        <Button
            android:id="@+id/btnGoToStock"
            style="@style/ButtonDefault"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="40dp"
            android:layout_marginVertical="20dp"
            android:layout_height="wrap_content"
            android:text="@string/goToTasks" />
        <Button
            android:id="@+id/btnGoToProfile"
            style="@style/ButtonDefault"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="40dp"
            android:layout_marginVertical="20dp"
            android:layout_height="wrap_content"
            android:text="@string/goToTasks" />


    </LinearLayout>

    <Button
        android:id="@+id/btnGoBack"
        style="@style/ButtonDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="120dp"
        android:layout_marginVertical="20dp"
        android:text="@string/goBack"

        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>